# Banco PostgreSQL — Railway fornece automaticamente quando adiciona o plugin Postgres
DATABASE_URL="postgresql://usuario:senha@localhost:5432/emporio?schema=public"

# JWT — TROCAR EM PRODUÇÃO! Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-este-valor-em-producao-use-algo-aleatorio-de-32-caracteres-no-minimo"

# CORS — separar URLs por vírgula. Em desenvolvimento, deixe '*' ou aponte para o frontend local
CORS_ORIGIN="http://localhost:3000"

# Ambiente
NODE_ENV="development"
LOG_LEVEL="info"

# Porta — Railway define automaticamente; localmente usa 3001
PORT=3001
